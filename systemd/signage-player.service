[Unit]
Description=Signage-player (afspelen op het HDMI-scherm)
Documentation=file:///opt/signage/current/README.md
After=signage-server.service systemd-user-sessions.service
Wants=signage-server.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=signage
Group=signage
Environment=PYTHONPATH=/opt/signage/current/app
Environment=SIGNAGE_PLAYER_CONFIG=/etc/signage/player.ini
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/signage-player
RuntimeDirectory=signage-player
ExecStart=/usr/bin/python3 -m signage.player.daemon
# De daemon meldt zich elke 0,2 s; blijft dat 60 s uit, dan herstart systemd de player.
WatchdogSec=60
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
