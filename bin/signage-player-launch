#!/bin/bash
# Startscript van signage-player.service.
#
# Kiest de weergave op basis van 'renderer' in /etc/signage/player.ini:
#   auto (standaard) / browser : Chromium-kiosk onder de compositor cage (foto, video, HTML, overgangen)
#   mpv                        : mpv direct op het scherm (foto, video, overgangen; geen HTML)
#
# Start de browserweergave drie keer achter elkaar niet (cage of Chromium stopt binnen 30 s),
# dan valt dit script automatisch terug op mpv, zodat het scherm niet zwart blijft.
# Terugzetten: sudo signage-admin renderer reset
#
# Stopt de browserweergave te snel, dan schrijft dit script de laatste uitvoer van cage,
# Chromium en de player plus wat sessie- en systeeminformatie naar
# /var/lib/signage/player/browser-last-failure.log. De beheerwebsite toont dat bestand onder
# Instellingen → Weergave, zodat de oorzaak zonder SSH te zien is.
set -u

PY=/usr/bin/python3
export PYTHONPATH="${PYTHONPATH:-/opt/signage/current/app}"
CFG="${SIGNAGE_PLAYER_CONFIG:-/etc/signage/player.ini}"
STATE_DIR="${SIGNAGE_PLAYER_STATE_DIR:-/var/lib/signage/player}"
FAILS_FILE="$STATE_DIR/browser-failures"
LAST_FAIL="$STATE_DIR/browser-last-failure.log"
VARIANT_FILE="$STATE_DIR/browser-variant"
OUT="${XDG_RUNTIME_DIR:-/tmp}/browser-output.txt"
mkdir -p "$STATE_DIR" 2>/dev/null || true

# Eerste N regels direct (regel voor regel) naar een bestand schrijven, de rest negeren.
# Niet met awk/head: die bufferen, en zolang de player-daemon na een crash van cage nog
# draait blijft de pijp open en zou er niets in het bestand komen.
keep_lines() {
    local n=0 line
    exec 3>>"$2"
    while IFS= read -r line; do
        if [ "$n" -lt "$1" ]; then printf '%s\n' "$line" >&3; n=$((n + 1)); fi
    done
}

diagnose() {
    echo "Signage:   $(cat /opt/signage/current/VERSION 2>/dev/null || echo '?')"
    echo "Systeem:   $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}") · kernel $(uname -r) · $(tr -d '\0' 2>/dev/null < /proc/device-tree/model || uname -m)"
    echo "cage:      $(command -v cage || echo ontbreekt)"
    local cb
    cb="$(command -v chromium || command -v chromium-browser || true)"
    echo "Chromium:  ${cb:-ontbreekt} $( [ -n "$cb" ] && timeout 5 "$cb" --version 2>/dev/null | head -n 1)"
    echo "Gebruiker: $(id)"
    echo "Sessie:    XDG_SESSION_ID=${XDG_SESSION_ID:-} XDG_SEAT=${XDG_SEAT:-} XDG_VTNR=${XDG_VTNR:-} XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
    if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
        echo "logind:    $(loginctl show-session "$XDG_SESSION_ID" -p Active -p State -p Seat -p VTNr -p TTY -p Type -p Class 2>&1 | tr '\n' ' ')"
    fi
    echo "Console:   actieve VT $(cat /sys/class/tty/tty0/active 2>/dev/null || echo '?')"
    echo "DRM:       $(ls -l /dev/dri 2>&1 | tail -n +2 | awk '{print $1, $3, $4, $NF}' | tr '\n' ';')"
    echo "HDMI:      $(for f in /sys/class/drm/*/status; do printf '%s=%s ' "$(basename "$(dirname "$f")")" "$(cat "$f")"; done 2>/dev/null)"
    echo "Geheugen:  $(awk '/MemTotal|MemAvailable|CmaTotal|CmaFree/ {printf "%s %d MB  ", $1, $2/1024}' /proc/meminfo)"
}

renderer="$("$PY" -c 'import configparser,sys
c = configparser.ConfigParser(interpolation=None); c.read(sys.argv[1])
print(c.get("player", "renderer", fallback="auto").strip().lower())' "$CFG" 2>/dev/null || echo auto)"

have_browser() {
    command -v cage >/dev/null 2>&1 && { command -v chromium >/dev/null 2>&1 || command -v chromium-browser >/dev/null 2>&1; }
}

fails="$(cat "$FAILS_FILE" 2>/dev/null || echo 0)"
[[ "$fails" =~ ^[0-9]+$ ]] || fails=0
mode=mpv
note=""
case "$renderer" in
    browser|auto)
        if ! have_browser; then
            [ "$renderer" = browser ] && note="Browserweergave gekozen, maar cage of Chromium ontbreekt; mpv wordt gebruikt (HTML wordt overgeslagen)."
        elif [ "$fails" -ge 3 ]; then
            note="Browserweergave startte 3 keer niet; teruggevallen op mpv (HTML wordt overgeslagen). Herstel: sudo signage-admin renderer reset"
        else
            mode=browser
        fi
        ;;
esac

if [ "$mode" = browser ]; then
    # Varianten voor de compositor, van normaal naar het veiligst. Stopt de browserweergave te
    # snel, dan probeert de volgende start de volgende variant; een variant die werkt wordt
    # onthouden. Bekende problemen op de Pi (vc4): hardwarecursor en atomic modesetting.
    #   0  normaal
    #   1  geen hardwarecursor, klassieke modesetting (WLR_DRM_NO_ATOMIC)
    #   2  als 1, plus tekenen zonder GPU in de compositor (WLR_RENDERER=pixman)
    variant="$(cat "$VARIANT_FILE" 2>/dev/null || echo 0)"
    [[ "$variant" =~ ^[0-2]$ ]] || variant=0
    vars=()
    [ "$variant" -ge 1 ] && vars+=(WLR_NO_HARDWARE_CURSORS=1 WLR_DRM_NO_ATOMIC=1)
    [ "$variant" -ge 2 ] && vars+=(WLR_RENDERER=pixman)
    opts=(-s)   # -s: wisselen naar een andere console (Ctrl+Alt+F2) blijft mogelijk
    # Na een mislukte start uitgebreid loggen (als deze cage-versie dat kan).
    if [ "$fails" -gt 0 ] && cage -h 2>&1 | grep -q -- '-D'; then opts+=(-D); fi
    echo "signage-player-launch: browserweergave starten (variant $variant${vars[*]:+: ${vars[*]}})." >&2
    start=$(date +%s)
    # Uitvoer gaat naar het systeemlogboek en (de eerste 3000 regels, direct weggeschreven)
    # naar een bestand in het geheugen voor de foutmelding in de website.
    : > "$OUT" 2>/dev/null || OUT=/dev/null
    env "${vars[@]}" cage "${opts[@]}" -- "$PY" -m signage.player.daemon --renderer browser \
        > >(tee -p >(keep_lines 3000 "$OUT")) 2>&1 &
    child=$!
    trap 'kill -TERM "$child" 2>/dev/null; wait "$child"; exit 0' TERM INT
    wait "$child"
    rc=$?
    ran=$(( $(date +%s) - start ))
    if [ "$ran" -lt 30 ]; then
        echo $(( fails + 1 )) > "$FAILS_FILE"
        [ "$variant" -lt 2 ] && echo $(( variant + 1 )) > "$VARIANT_FILE"
        why=""
        [ "$rc" -gt 128 ] && why=" (signaal $(( rc - 128 ))$( [ "$rc" = 134 ] && echo ': afgebroken (abort)')$( [ "$rc" = 139 ] && echo ': geheugenfout (segfault)'))"
        echo "signage-player-launch: browserweergave stopte na ${ran}s met exitcode $rc$why (poging $(( fails + 1 )) van 3, variant $variant)." >&2
        sleep 1
        {
            echo "Browserweergave stopte na ${ran} s met exitcode $rc$why (poging $(( fails + 1 )) van 3, variant $variant) — $(date '+%Y-%m-%d %H:%M:%S')"
            [ ${#vars[@]} -gt 0 ] && echo "Omgeving: ${vars[*]}"
            echo
            diagnose
            echo
            echo "--- Uitvoer van cage, Chromium en de player ---"
            cat "$OUT" 2>/dev/null
            if [ ! -s "$OUT" ] && command -v journalctl >/dev/null 2>&1; then
                echo "(geen uitvoer opgevangen; laatste regels uit het systeemlogboek:)"
                journalctl -u signage-player.service -b -n 60 --no-pager -o short-monotonic 2>&1 | tail -n 60
            fi
        } > "$LAST_FAIL.tmp" 2>&1
        chmod 0644 "$LAST_FAIL.tmp" 2>/dev/null
        mv -f "$LAST_FAIL.tmp" "$LAST_FAIL" 2>/dev/null
        sed -n '1,/^--- /p' "$LAST_FAIL" >&2 2>/dev/null
    else
        echo 0 > "$FAILS_FILE"
        [ "$variant" -gt 0 ] && echo "signage-player-launch: variant $variant werkt; die blijft in gebruik." >&2
    fi
    exit "$rc"
fi

if [ -n "$note" ]; then
    echo "signage-player-launch: $note" >&2
    exec "$PY" -m signage.player.daemon --renderer mpv --note "$note"
fi
exec "$PY" -m signage.player.daemon --renderer mpv
